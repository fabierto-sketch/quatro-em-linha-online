# Copie este ficheiro para ".env" para testar localmente.
# No Render, defina estas variáveis em: Service > Environment.

# OBRIGATÓRIO — palavra-passe da área de administração (mínimo 6 caracteres).
ADMIN_PASSWORD=mude-esta-palavra-passe

# Porta local (o Render define PORT automaticamente — não a altere lá).
PORT=3000

# Endereço público usado nos links de convite (opcional; detetado automaticamente).
# PUBLIC_URL=https://quatro-em-linha-online.onrender.com

# Redirecionar HTTP para HTTPS (recomendado no Render).
FORCE_HTTPS=true

# --- Videochamada (WebRTC) ---------------------------------------------
# STUN gratuito já incluído. Para ligações difíceis (redes móveis, 4G/5G,
# routers empresariais) configure também um servidor TURN, por exemplo
# o plano gratuito da Metered (https://www.metered.ca/stun-turn).
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
# STUN_URLS=stun:stun.l.google.com:19302

# --- Opcionais -------------------------------------------------------------
# Horas de validade da sessão de administrador
# ADMIN_SESSION_HOURS=12
# Minutos que um lugar fica reservado a um jogador desligado
# SEAT_TIMEOUT_MINUTES=60
# Horas sem atividade até uma mesa ser apagada automaticamente
# ROOM_TTL_HOURS=168
# Número máximo de mesas em simultâneo
# MAX_ROOMS=200
